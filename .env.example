# bale-auto — example environment for the production Bale bot.
# Copy to .env (or .env.local) on the deployment host and fill in real values.
# NEVER commit real values: .env and .env.* are git-ignored; only this
# .env.example file is tracked. Every variable below is one the code
# actually reads (src/bale_bot.py), verified 2026-10-28 against origin/main.

# --- Bale bot (required) ---
# Token issued by @BaleBotFather for the production bot.
BALE_BOT_TOKEN=
# Bale Bot API base. Default in code: https://tapi.bale.ai
BALE_API_BASE=https://tapi.bale.ai

# --- Ledger storage ---
# SQLite ledger path. Default in code: /home/admin/bale-auto/data/ledger.db
LEDGER_DB_PATH=

# --- Bale-Panel shadow telemetry (optional, OFF by default) ---
# Emission transmits raw message text and identifiers to the panel.
# Keep disabled unless the operator explicitly accepts that exposure.
ENABLE_PANEL_EMIT=0
# Legacy/alternate kill-switch also read by the code.
DISABLE_PANEL_EMIT=
PANEL_BASE_URL=
PANEL_API_SECRET=
PANEL_OPERATOR_TOKEN=
PANEL_SHADOW_TRACE_URL=

# Present in the live server .env but NOT read by the current code;
# kept here only so the live file and this template stay reconcilable.
BALE_BOT_USERNAME=
